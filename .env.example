# Copy this file to .env to override defaults. .env is gitignored.

# Port the server listens on.
#PORT=3000

# If both Wi-Fi and Ethernet are connected, the server may pick the wrong
# adapter's IP for the displayed URL / QR code. Force it with one of:

# Option A: name the adapter to use (macOS: `ifconfig`, e.g. en0 = Wi-Fi;
# Windows: `ipconfig`, e.g. "Wi-Fi" or "Ethernet").
#NETWORK_INTERFACE=en0

# Option B: hardcode the IP directly (takes priority over NETWORK_INTERFACE).
#HOST=192.168.1.50
